{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://static.wixstatic.com/media/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/projects/:slug/index.html",
      "destination": "/projects/:slug/",
      "permanent": true
    },
    {
      "source": "/projects/yosemite-national-park-after-dark/:path*",
      "destination": "/projects/yosemite-national-park/",
      "permanent": true
    },
    {
      "source": "/projects/parks-after-dark/:path*",
      "destination": "/projects/yosemite-national-park/",
      "permanent": true
    },
    {
      "source": "/projects/social-media-yosemite/:path*",
      "destination": "/projects/mount-rainier-social-media/",
      "permanent": true
    },
    {
      "source": "/projects/industri-alphabet/:path*",
      "destination": "/projects/met-alphabet/",
      "permanent": true
    },
    {
      "source": "/projects/heavy-met-alphabet/:path*",
      "destination": "/projects/met-alphabet/",
      "permanent": true
    },
    {
      "source": "/projects/bear-with-me/:path*",
      "destination": "/projects/peak-season/",
      "permanent": true
    }
  ],
  "cleanUrls": true,
  "trailingSlash": true
}